# ============================================================================
# 1. Providers / API credentials
# ============================================================================

# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# TypeSafe Jev: screens StockTwits and Reddit posts for the Sentiment Analyst. Optional.
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# Remote Ollama server. Unset uses http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# ============================================================================
# 2. Core model routing
# ============================================================================

# Override these DEFAULT_CONFIG keys. Provider, models, language and round counts also skip their CLI prompt.
#TRADINGAGENTS_LLM_PROVIDER=openai

# Model roles: Generation (produce/structure/synthesize/propose/decide) vs
# Review (challenge/verify/audit/correct/repair) -- see README: "Model
# roles: Generation vs Review". May be the same model or different ones.
#TRADINGAGENTS_GENERATION_LLM=gpt-6-luna
#TRADINGAGENTS_REVIEW_LLM=gpt-6-sol

# Per-role reasoning effort (OpenAI reasoning-tier models and Ollama's
# OpenAI-compatible endpoint only -- see README: "Model roles: Generation vs
# Review"). Valid levels are model/backend-specific, not enforced here.
# Unset sends no override, so the backend/model's own default applies.
#TRADINGAGENTS_GENERATION_REASONING_EFFORT=
#TRADINGAGENTS_REVIEW_REASONING_EFFORT=

#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Reasoning depth per provider; setting one skips its prompt. These are
# single, role-agnostic knobs (unlike the per-role settings above), and are
# the only reasoning-depth control for Google/Anthropic -- those two
# providers do not read the per-role *_REASONING_EFFORT settings above.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# ============================================================================
# 3. Validation
# ============================================================================

# Validator: a lightweight, opt-in contract/format/arithmetic quality-control
# role, deliberately separate from Generation/Review (see README: "Generation
# / Validation / Review").
#
# - TRADINGAGENTS_VALIDATOR_LLM alone does NOT turn validation on --
#   TRADINGAGENTS_VALIDATION_ENABLED must also be true, or this model is
#   configured but never called.
# - There is no silent fallback to the Generation model: if validation is
#   enabled without a validator model configured, the run fails loudly
#   before any work starts, rather than silently using Generation's model
#   (which would change cost/behavior without being asked to).
#TRADINGAGENTS_VALIDATOR_LLM=
#TRADINGAGENTS_VALIDATOR_REASONING_EFFORT=
#TRADINGAGENTS_VALIDATION_ENABLED=false

# ============================================================================
# 4. Decision Memory
# ============================================================================

# Decision Memory isolation (see README: "Decision memory isolation") --
# resolve_decision_memory_config is the single place these two are consulted.
#
# - TRADINGAGENTS_DECISION_MEMORY_ENABLED=false disables Decision Memory
#   completely: no past reflections/outcomes are read, AND this run's own
#   decision is never written to it either (read=false, write=false, not
#   just "stop reading").
# - TRADINGAGENTS_DECISION_MEMORY_ROOT points Decision Memory (both read and
#   write) at an isolated store instead of the normal one.
# - These two are mutually exclusive -- setting both raises a clear error at
#   startup rather than silently picking one.
# - For a clean historical/backtest run, prefer the CLI flag
#   (`--no-decision-memory`) over setting TRADINGAGENTS_DECISION_MEMORY_ENABLED
#   here: the flag is then visible in the command line and in that run's own
#   log, rather than only in .env where it is easy to forget it is set.
#TRADINGAGENTS_DECISION_MEMORY_ENABLED=true
#TRADINGAGENTS_DECISION_MEMORY_ROOT=

# ============================================================================
# 5. Other settings (paths, sampling, retries, seed, batch defaults)
# ============================================================================

# Paths and alpha benchmark. Unset uses ~/.tradingagents and the regional index.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
# Ollama already defaults to 8192 as a runaway-generation safety guardrail
# (a local model has no provider-side output cap and can fail to ever emit a
# stop token); this is not the context length (num_ctx) -- set it explicitly
# here to override that default, for Ollama or any other provider.
#TRADINGAGENTS_MAX_TOKENS=8192

# Best-effort deterministic replay base seed (see README: "Best-effort
# deterministic replay"). 0 (the default) auto-generates a fresh base seed
# each run and prints it; set a non-zero value here to reuse one across runs.
#TRADINGAGENTS_SEED=0

# Defaults for `tradingagents batch` (and only `batch`) when --analysts/--depth
# are omitted; --tickers/--tickers-file stays the only required flag.
#TRADINGAGENTS_ANALYSTS=market,social,news,fundamentals
#TRADINGAGENTS_DEPTH=medium

# ============================================================================
# 6. Example profiles (reference only -- commented out, not auto-applied)
# ============================================================================
#
# These are complete, self-contained routing examples. Uncomment ONE
# profile's block (and nothing else in this section) to actually apply it;
# leaving everything commented preserves the existing default behavior.

# ----------------------------------------------------------------------
# Profile A -- Local / low-cost
# ----------------------------------------------------------------------
# Generation and Review on a locally-hosted Qwen model, Validation on a
# locally-hosted Gemma model, served through whichever local/OpenAI-
# compatible/Ollama backend this project already supports (see
# TRADINGAGENTS_LLM_PROVIDER and OLLAMA_BASE_URL above).
#
# The placeholders below are intentional: the exact identifier depends on
# your own local backend/model registry (what you actually pulled/serve),
# not on a name this project hardcodes. For reference, this project has
# previously run a locally-hosted Qwen 3.8 Flash Next 125B as
# `qwen3.8-flash-next:125b-a6b-q4_K_M` (in the Review role) and Gemma 4 26B
# as `gemma4:26b` (in the Validator role) -- see README: "Previous
# local-only routing (superseded for large-scale historical work)" -- but
# your own local tag will likely differ.
#TRADINGAGENTS_GENERATION_LLM=<your-local-qwen-model>
#TRADINGAGENTS_REVIEW_LLM=<your-local-qwen-model>
#TRADINGAGENTS_VALIDATOR_LLM=<your-local-gemma-model>
#TRADINGAGENTS_GENERATION_REASONING_EFFORT=medium
#TRADINGAGENTS_REVIEW_REASONING_EFFORT=medium
#TRADINGAGENTS_VALIDATOR_REASONING_EFFORT=medium
#TRADINGAGENTS_VALIDATION_ENABLED=true

# ----------------------------------------------------------------------
# Profile B -- Low-cost cloud
# ----------------------------------------------------------------------
# The exact cloud routing this project is currently using experimentally
# (see README: "Current preferred routing" / "Cloud model experiment").
# This profile prioritizes cost/speed -- it is NOT a claim that it is the
# highest-quality configuration available, only the current cost/speed-
# oriented pick.
#TRADINGAGENTS_GENERATION_LLM=deepseek-v4.1-flash:cloud
#TRADINGAGENTS_GENERATION_REASONING_EFFORT=high

#TRADINGAGENTS_REVIEW_LLM=nemotron-3-super:cloud
#TRADINGAGENTS_REVIEW_REASONING_EFFORT=medium

#TRADINGAGENTS_VALIDATOR_LLM=gemma4:31b-cloud
# No validator reasoning effort has actually been set/validated for this
# role in this project's own cloud runs yet -- left unset rather than
# guessed, so the model/provider's own default applies.
#TRADINGAGENTS_VALIDATOR_REASONING_EFFORT=
#TRADINGAGENTS_VALIDATION_ENABLED=true

# ----------------------------------------------------------------------
# Profile C -- Higher-quality cloud routing
# ----------------------------------------------------------------------
# Reserved for configurations validated through future experiments
# (for example OpenAI and/or Anthropic models).

# ============================================================================
# 7. Legacy / deprecated (still accepted -- see README "Legacy naming")
# ============================================================================

# quick -> generation, deep -> review. An explicit *_GENERATION_LLM/
# *_REVIEW_LLM above always wins if both are set.
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
#TRADINGAGENTS_QUICK_REASONING_EFFORT=
#TRADINGAGENTS_DEEP_REASONING_EFFORT=
